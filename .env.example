# Required: Sarvam API key (https://dashboard.sarvam.ai)
SARVAM_API_KEY=

# Optional: a second Sarvam key tried automatically if the primary returns
# 401/403/429 (auth failure / quota / rate limit). Useful for demos with
# multiple sub-accounts.
SARVAM_API_KEY_FALLBACK=

# Optional: only needed if you swap the LLM provider via LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Optional overrides
LLM_PROVIDER=sarvam          # sarvam | gemini
SARVAM_CHAT_MODEL=sarvam-m
SARVAM_STT_MODEL=saaras:v3
SARVAM_TRANSLATE_MODEL=mayura:v1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval + grounding thresholds
RETRIEVAL_K=5
GROUNDING_SIM_THRESHOLD=0.25
CHUNK_TARGET_SECONDS=45
CHUNK_OVERLAP_SEGMENTS=1
